{
  "name": "@hemiil/hetu",
  "version": "1.0.0",
  "description": "Modern, zero-dependency TypeScript library for Finnish personal identity codes (HETU)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run check && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "package-check": "publint && attw --pack . --profile esm-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemiil/hetu-ts.git"
  },
  "keywords": [
    "hetu",
    "finnish",
    "ssn",
    "typescript",
    "validation"
  ],
  "author": "hemiil",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.14.0",
    "prettier": "3.4.2",
    "publint": "^0.3.25",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3"
  }
}
